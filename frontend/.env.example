# Copy to .env.local (gitignored) and fill in:
#   cp .env.example .env.local
# Both values are read only on the Next.js server; they never reach the browser.

# Where the Go backend runs
API_URL=http://localhost:8080

# Must equal frontend.api_key in backend/config.local.yml
FRONTEND_API_KEY=replace-with-the-backend-frontend-api-key
