# Editor settings shared across the repo. VS Code needs the "EditorConfig for VS Code" extension.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# Formats whose tools or specs require spaces
[*.{json,yml,yaml,md,tf,tfvars}]
indent_style = space
indent_size = 2
